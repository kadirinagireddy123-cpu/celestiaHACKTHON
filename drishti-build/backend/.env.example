# Drishti Backend Configuration

# Server Port
PORT=5000

# Server Host
HOST=0.0.0.0

# Client Origins for CORS (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
# If empty, backend automatically runs in resilient DEMO MODE with realistic simulated responses
GEMINI_API_KEY=

# Gemini Models Configuration
# Primary vision & chat model
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
# Fallback model in case of rate limits or service unavailability
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
# Audio / TTS Model
GEMINI_TTS_MODEL=gemini-2.5-flash

# Maximum Image Payload Size
MAX_BODY_SIZE=30mb

# Environment: development / production / test
NODE_ENV=development

